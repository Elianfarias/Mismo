    m_Localized: MATERIAL
    m_Metadata:
      m_Items: []
  - m_Id: 2441400362
    m_Localized: ARMA
    m_Metadata:
      m_Items: []
  - m_Id: 2441400363
    m_Localized: "Recurso para preparar tu pr\xF3xima salida."
    m_Metadata:
      m_Items: []
  - m_Id: 2441400364
    m_Localized: "Seleccion\xE1 una ranura para comparar y equipar."
