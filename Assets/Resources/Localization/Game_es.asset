    m_Metadata:
      m_Items: []
  - m_Id: 2441400372
    m_Localized: Descartar
    m_Metadata:
      m_Items: []
  - m_Id: 2441400373
    m_Localized: "Seleccion\xE1 una ranura para consultar sus habilidades."
    m_Metadata:
      m_Items: []
  - m_Id: 2441400374
    m_Localized: "Nivel m\xE1ximo"
    m_Metadata:
      m_Items: []
  - m_Id: 2441400375
    m_Localized: Mejorar +
    m_Metadata:
      m_Items: []
  - m_Id: 2441400376
    m_Localized: "MAESTR\xCDA DE ARMA"
    m_Metadata:
      m_Items: []
  - m_Id: 2441400377
    m_Localized: "Maestr\xEDa m\xE1xima"
    m_Metadata:
      m_Items: []
  - m_Id: 2441400378
    m_Localized: "Eleg\xED otra arma en la pesta\xF1a Armas para ver su maestr\xEDa.\nEl
      progreso se comparte entre ejemplares de la misma familia. El alcance no aumenta."
    m_Metadata:
      m_Items: []
