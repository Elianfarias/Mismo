    m_Metadata:
      m_Items: []
  - m_Id: 2441400432
    m_Localized: "Vida m\xE1xima: {0:0.#} \xB7 Armadura: {1:0.#}\nLos bonos de ambas
      armas est\xE1n activos."
    m_Metadata:
      m_Items: []
  - m_Id: 2441400433
    m_Localized: '{0}

      Familia: {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2441400434
    m_Localized: "Nivel {0} \xB7 Puntos: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2441400435
    m_Localized: "Inventario guardado autom\xE1ticamente."
    m_Metadata:
      m_Items: []
  - m_Id: 2441400436
    m_Localized: No hay espacio para acomodar todos los objetos.
    m_Metadata:
      m_Items: []
  - m_Id: 2441400437
    m_Localized: "No hay un hueco con la forma necesaria. Reorganiz\xE1, guard\xE1
      o descart\xE1 objetos."
    m_Metadata:
      m_Items: []
  - m_Id: 2441400438
    m_Localized: No hay un hueco con la forma necesaria en el cofre.
    m_Metadata:
      m_Items: []
  - m_Id: 2441400439
    m_Localized: "Se recuper\xF3 la copia de respaldo del inventario."
    m_Metadata:
      m_Items: []
  - m_Id: 2441400440
    m_Localized: "No se pudo guardar el cambio. Volv\xE9 a intentarlo; tu equipo
      anterior sigue intacto."
    m_Metadata:
      m_Items: []
  - m_Id: 2441400441
    m_Localized: "No se pudo recuperar el guardado. Tus archivos se conservaron;
      no se guardar\xE1n cambios."
    m_Metadata:
      m_Items: []
  - m_Id: 2441400442
    m_Localized: "No se pudo acceder al guardado. Tus archivos se conservaron; no
      se guardar\xE1n cambios."
    m_Metadata:
      m_Items: []
