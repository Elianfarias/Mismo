    m_Metadata:
      m_Items: []
  - m_Id: 2441400351
    m_Localized: "Buscar objetos\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2441400352
    m_Localized: Organizar
    m_Metadata:
      m_Items: []
  - m_Id: 2441400353
    m_Localized: "Arrastr\xE1 para mover \xB7 R para girar al arrastrar"
    m_Metadata:
      m_Items: []
  - m_Id: 2441400354
    m_Localized: "SIN UBICAR \xB7 Guard\xE1 o descart\xE1 para liberar espacio"
    m_Metadata:
      m_Items: []
  - m_Id: 2441400355
    m_Localized: "Arrastr\xE1 para rotar"
    m_Metadata:
      m_Items: []
  - m_Id: 2441400356
    m_Localized: TU PERSONAJE
    m_Metadata:
      m_Items: []
  - m_Id: 2441400357
    m_Localized: "Seleccion\xE1 un objeto para inspeccionarlo."
    m_Metadata:
      m_Items: []
  - m_Id: 2441400358
    m_Localized: "\u2190 Personaje"
    m_Metadata:
      m_Items: []
  - m_Id: 2441400359
