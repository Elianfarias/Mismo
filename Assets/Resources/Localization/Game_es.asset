    m_Metadata:
      m_Items: []
  - m_Id: 2441400368
    m_Localized: Guardar en cofre
    m_Metadata:
      m_Items: []
  - m_Id: 2441400369
    m_Localized: "Descartar\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2441400370
    m_Localized: "\xBFDescartar definitivamente?"
    m_Metadata:
      m_Items: []
  - m_Id: 2441400371
