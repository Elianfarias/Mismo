    m_Metadata:
      m_Items: []
  - m_Id: 2441400410
    m_Localized: "Distribuci\xF3n guardada."
    m_Metadata:
      m_Items: []
  - m_Id: 2441400411
    m_Localized: Inventario organizado.
    m_Metadata:
      m_Items: []
  - m_Id: 2441400412
    m_Localized: COMBO
    m_Metadata:
      m_Items: []
  - m_Id: 2441400413
    m_Localized: Encadena ataques de espada contra los enemigos que tengas delante.
    m_Metadata:
      m_Items: []
  - m_Id: 2441400414
    m_Localized: ESTOCADA
    m_Metadata:
      m_Items: []
  - m_Id: 2441400415
    m_Localized: Avanza con una estocada para golpear al enemigo de frente.
    m_Metadata:
      m_Items: []
  - m_Id: 2441400416
    m_Localized: PARRY
    m_Metadata:
      m_Items: []
  - m_Id: 2441400417
    m_Localized: Defiende en el momento justo para desviar el ataque enemigo.
    m_Metadata:
      m_Items: []
  - m_Id: 2441400418
    m_Localized: GIRO
    m_Metadata:
      m_Items: []
  - m_Id: 2441400419
    m_Localized: Gira con la espada y golpea a los enemigos cercanos.
    m_Metadata:
      m_Items: []
  - m_Id: 2441400420
    m_Localized: FLECHA
    m_Metadata:
      m_Items: []
  - m_Id: 2441400421
    m_Localized: Dispara una flecha hacia donde apuntas.
    m_Metadata:
      m_Items: []
  - m_Id: 2441400422
    m_Localized: POTENTE
    m_Metadata:
      m_Items: []
  - m_Id: 2441400423
    m_Localized: "Dispara una flecha potente que causa da\xF1o y reduce la postura
      del enemigo."
    m_Metadata:
      m_Items: []
  - m_Id: 2441400424
    m_Localized: RETIRADA
    m_Metadata:
      m_Items: []
  - m_Id: 2441400425
    m_Localized: Retrocede mientras disparas una flecha para crear distancia.
    m_Metadata:
      m_Items: []
  - m_Id: 2441400426
    m_Localized: LLUVIA
    m_Metadata:
      m_Items: []
  - m_Id: 2441400427
    m_Localized: "Lanza una lluvia de flechas sobre el \xE1rea seleccionada."
    m_Metadata:
      m_Items: []
  - m_Id: 2441400428
    m_Localized: +{0} vida
    m_Metadata:
      m_Items: []
