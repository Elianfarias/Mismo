  m_Script: {fileID: 11500000, guid: 896a2bf93103469e9b6dd65366a25458, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Mismo.Gameplay.Player::Mismo.Gameplay.Player.Presentation.DemoIntroduction
  player: {fileID: 2115274913}
  guide: {fileID: 2115274916}
  view: {fileID: 1502577891}
  stages:
  - title: Salir de la cueva
    instruction: "WASD \xB7 Moverte\nMouse \xB7 Mirar alrededor"
    destination: {fileID: 1072428549}
    radius: 8
    lesson: {fileID: 11400000, guid: 0eabf35bb84a71c4f986e915868ecfeb, type: 2}
    encounter: {fileID: 0}
    objective: 0
    weapon: {fileID: 0}
  - title: Primer combate
    instruction: "Atac\xE1 con M1 y esquiv\xE1 con C.\nH \xB7 Volver a leer la explicaci\xF3n"
    destination: {fileID: 1503876540}
    radius: 8
    lesson: {fileID: 11400000, guid: 75aea8f1a0c3d8147a0ef183518ef3be, type: 2}
    encounter: {fileID: 1953227925}
    objective: 1
    weapon: {fileID: 0}
  - title: Romper postura
    instruction: "Atac\xE1 al goblin y aprovech\xE1 el stagger.\nH \xB7 Volver a leer la explicaci\xF3n"
    destination: {fileID: 1665858751}
    radius: 8
    lesson: {fileID: 11400000, guid: 8a0fba9f2f312fc48b5830c7f0d1275d, type: 2}
    encounter: {fileID: 366902813}
    objective: 1
    weapon: {fileID: 0}
  - title: Practicar parry
    instruction: "Espada: E justo antes del impacto.\nDerrot\xE1 al goblin para seguir."
    destination: {fileID: 1039270634}
    radius: 8
    lesson: {fileID: 11400000, guid: 1949c9db5b055b74abd516c1e593ab19, type: 2}
    encounter: {fileID: 983937648}
    objective: 1
    weapon: {fileID: 0}
  - title: Equipar el arco
    instruction: "Presion\xE1 Tab para cambiar al arco."
    destination: {fileID: 2146509419}
    radius: 8
    lesson: {fileID: 11400000, guid: b54f1a3e9d382944d916da82fe76714e, type: 2}
    encounter: {fileID: 0}
    objective: 2
    weapon: {fileID: 11400000, guid: 835c07f02b4157f4ca9e69fe3d5490ad, type: 2}
  - title: Arco y Focus
    instruction: "Acert\xE1 disparos con M1 y us\xE1 Q.\nDerrot\xE1 al goblin para seguir."
    destination: {fileID: 1111312166}
    radius: 8
    lesson: {fileID: 11400000, guid: 9a9c878bcc77b224cafc516da0b84893, type: 2}
    encounter: {fileID: 1852651434}
    objective: 1
    weapon: {fileID: 0}
  - title: "\xDAltimo encuentro"
    instruction: "Combin\xE1 tus armas y habilidades.\nEl pueblo est\xE1 al final del sendero."
    destination: {fileID: 1944506107}
    radius: 8
    lesson: {fileID: 11400000, guid: 2fbf497bbd1fed54797b0567c2f35272, type: 2}
    encounter: {fileID: 278244484}
    objective: 1
    weapon: {fileID: 0}
  - title: Llegar al pueblo
    instruction: "Segu\xED el camino hasta las casas."
    destination: {fileID: 406227284}
    radius: 8
    lesson: {fileID: 11400000, guid: 5147e302d54c2864c8ee62cd9a6246e7, type: 2}
    encounter: {fileID: 0}
    objective: 0
    weapon: {fileID: 0}
  introductionSeconds: 5
