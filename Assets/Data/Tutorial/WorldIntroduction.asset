    requiredWeapon: {fileID: 0}
    lessonWeapon: {fileID: 0}
    count: 1
  - title: Practicar parry
    instruction: "Espada: E justo antes del impacto.\nDerrot\xE1 al goblin para seguir."
    offset: {x: -12, y: -165}
    lesson: {fileID: 11400000, guid: 1949c9db5b055b74abd516c1e593ab19, type: 2}
    prefab: {fileID: 5335981839036757142, guid: 4c185bcb06948d34f8cbe1437ef73bdf, type: 3}
    requiredWeapon: {fileID: 0}
    lessonWeapon: {fileID: 0}
    count: 1
  - title: Equipar el arco
    instruction: "Tab alterna tus armas. Equip\xE1 el arco; I permite revisar tus conjuntos."
    offset: {x: 8, y: -152}
    lesson: {fileID: 11400000, guid: b54f1a3e9d382944d916da82fe76714e, type: 2}
    prefab: {fileID: 0}
    requiredWeapon: {fileID: 11400000, guid: 835c07f02b4157f4ca9e69fe3d5490ad, type: 2}
    lessonWeapon: {fileID: 0}
    count: 1
  - title: Arco y Focus
    instruction: "Manten\xE9 M1 para tensar y solt\xE1 para disparar. Acert\xE1 para generar Focus y usar Q."
    offset: {x: 12, y: -139}
    lesson: {fileID: 11400000, guid: eb3a73a4a8e4b4c45b6775d6b323fe91, type: 2}
