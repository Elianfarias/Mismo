    lessonWeapon: {fileID: 11400000, guid: 835c07f02b4157f4ca9e69fe3d5490ad, type: 2}
    count: 1
  - title: "El \xFAltimo tramo"
    instruction: "Combin\xE1 espada, arco y habilidades. Despej\xE1 el camino hasta el pueblo."
