    lessonWeapon: {fileID: 0}
    count: 1
  - title: Romper postura
    instruction: "Atac\xE1 al goblin y aprovech\xE1 su stagger."
    offset: {x: 14, y: -191}
    lesson: {fileID: 11400000, guid: 8a0fba9f2f312fc48b5830c7f0d1275d, type: 2}
