  encounters:
  - title: Primer combate
    instruction: "M1 \xB7 Atacar    C \xB7 Esquivar\nDerrot\xE1 al goblin para despejar el camino."
    offset: {x: -12, y: -217}
    lesson: {fileID: 11400000, guid: 75aea8f1a0c3d8147a0ef183518ef3be, type: 2}
