  m_Script: {fileID: 11500000, guid: 43f02186b7da44ef9071f3f198480278, type: 3}
  m_Name: WorldFocus
  m_EditorClassIdentifier: Mismo.Gameplay.Player::Mismo.Gameplay.Player.Presentation.TutorialSequence
  id: world.introduction.worldfocus
  completionLabel: "Jugar \xB7 Enter"
  pages:
  - title: Tensar el arco
    body: "Manten\xE9 el clic izquierdo para tensar el arco y aumentar la potencia del disparo. Soltalo para disparar; al llegar a la carga m\xE1xima la flecha se dispara autom\xE1ticamente."
    highlight: 5
  - title: Generar Focus
    body: "Acertar un disparo b\xE1sico genera {basicGain} Focus. Los disparos fallidos no lo generan. El borde de las habilidades que consumen Focus muestra cu\xE1nto te falta."
    highlight: 5
  - title: La habilidad Q del arco
    body: "Ahora ten\xE9s {q} en Q. Cuesta {focusCost} Focus: acert\xE1 disparos b\xE1sicos para reunirlo y despu\xE9s presion\xE1 Q."
    highlight: 6
